{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/word-unscrambler",
      "has": [{ "type": "host", "value": "www.cluevra.com" }],
      "destination": "https://cluevra.com/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.cluevra.com" }],
      "destination": "https://cluevra.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/word-unscrambler",
      "destination": "https://cluevra.com/",
      "statusCode": 301
    }
  ],
  "rewrites": [
    { "source": "/word-finder", "destination": "/word-finder/index.html" },
    { "source": "/words-with-letters", "destination": "/words-with-letters/index.html" },
    { "source": "/anagram-solver", "destination": "/anagram-solver/index.html" },
    { "source": "/5-letter-word-finder", "destination": "/5-letter-word-finder/index.html" },
    { "source": "/6-letter-word-unscrambler", "destination": "/6-letter-word-unscrambler/index.html" },
    { "source": "/7-letter-word-unscrambler", "destination": "/7-letter-word-unscrambler/index.html" },
    { "source": "/8-letter-word-unscrambler", "destination": "/8-letter-word-unscrambler/index.html" },
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/privacy-policy", "destination": "/privacy-policy/index.html" },
    { "source": "/terms", "destination": "/terms/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" }
  ]
}